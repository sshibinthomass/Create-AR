# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Backend runtime data (uploads + conversion results)
backend/data/
backend/tests/_data/

# Frontend
node_modules/
frontend/dist/
*.tsbuildinfo

# Editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Sample generation only (not a runtime dependency)
samples/__pycache__/

# Local run configuration (paths, and potentially secrets)
.env
.env.*

# Claude Code worktrees live under .claude/ in the main checkout, and are
# machine-local copies of this repo -- never commit them.
.claude/worktrees/

# graphify build outputs. graph.json/graph.html and the extraction cache are
# large and regenerable (`/graphify --update`), and .graphify_python and
# .graphify_root hold absolute paths from whichever machine built them. The
# report is the one part worth reading in review, so it stays.
graphify-out/*
!graphify-out/GRAPH_REPORT.md
